{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drosophila-connectome.example/schemas/simulation-parameters.schema.json",
  "title": "Simulation parameter set",
  "description": "Versioned model parameters, separate from immutable raw data and derived connectome tables.",
  "type": "object",
  "additionalProperties": false,
  "required": ["parameter_set_id", "parameter_set_version", "data_manifest_id", "simulation", "neuron_model", "synapse_model", "connectivity", "execution", "provenance"],
  "properties": {
    "parameter_set_id": {"type": "string", "minLength": 1},
    "parameter_set_version": {"type": "string", "minLength": 1, "description": "Immutable version of this parameter set; create a new version rather than editing a recorded run."},
    "data_manifest_id": {"type": "string", "minLength": 1, "description": "Manifest identifying the exact normalized/aggregated data used."},
    "simulation": {"type": "object", "additionalProperties": false, "required": ["timestep_ms", "duration_ms", "seed"], "properties": {"timestep_ms": {"type": "number", "exclusiveMinimum": 0}, "duration_ms": {"type": "number", "exclusiveMinimum": 0}, "seed": {"type": "integer"}, "warmup_ms": {"type": "number", "minimum": 0}}},
    "neuron_model": {"type": "object", "additionalProperties": false, "required": ["name", "version", "parameters"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "parameters": {"type": "object", "description": "Model-specific, serializable neuron parameters."}}},
    "synapse_model": {"type": "object", "additionalProperties": false, "required": ["name", "version", "parameters"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "parameters": {"type": "object", "description": "Model-specific, serializable synapse parameters."}}},
    "connectivity": {"type": "object", "additionalProperties": false, "required": ["weight_field", "minimum_connection_confidence"], "properties": {"weight_field": {"type": "string", "minLength": 1}, "minimum_connection_confidence": {"type": "number", "minimum": 0, "maximum": 1}, "minimum_synapse_count": {"type": "integer", "minimum": 1}, "normalization": {"type": "string"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["engine", "engine_version"], "properties": {"engine": {"type": "string", "minLength": 1}, "engine_version": {"type": "string", "minLength": 1}, "hardware": {"type": "string"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["created_at", "created_by", "code_revision"], "properties": {"created_at": {"type": "string", "format": "date-time"}, "created_by": {"type": "string", "minLength": 1}, "code_revision": {"type": "string", "minLength": 1}, "notes": {"type": "string"}}}
  }
}
