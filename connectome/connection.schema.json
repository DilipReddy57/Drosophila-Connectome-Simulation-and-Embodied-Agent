{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drosophila-connectome.example/schemas/connection.schema.json",
  "title": "Aggregated connection",
  "description": "A derived directed edge aggregated from immutable raw synapse observations. Do not use this schema for individual raw synapses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "source_dataset", "source_version", "pre_neuron_id", "post_neuron_id", "pre_dense_index", "post_dense_index", "synapse_count", "connection_weight", "connection_confidence", "aggregation", "provenance"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "source_dataset": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "pre_neuron_id": {"type": "string", "minLength": 1},
    "post_neuron_id": {"type": "string", "minLength": 1},
    "pre_dense_index": {"type": "integer", "minimum": 0},
    "post_dense_index": {"type": "integer", "minimum": 0},
    "synapse_count": {"type": "integer", "minimum": 1},
    "connection_weight": {"type": "number", "description": "Derived simulation-ready edge weight; its calculation is stated in aggregation."},
    "neurotransmitter": {"type": ["string", "null"], "description": "Presynaptic transmitter carried to this edge when available."},
    "neurotransmitter_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "connection_confidence": {"type": "number", "minimum": 0, "maximum": 1, "description": "Confidence in the existence/quality of this aggregated connection, normalized to [0,1]."},
    "aggregation": {"type": "object", "additionalProperties": false, "required": ["method", "version", "raw_synapse_count"], "properties": {"method": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "raw_synapse_count": {"type": "integer", "minimum": 1}, "filter_expression": {"type": "string"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["raw_artifact_ids", "raw_artifact_sha256", "generated_at"], "properties": {"raw_artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "raw_artifact_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}, "generated_at": {"type": "string", "format": "date-time"}, "transformation": {"type": "string"}}}
  }
}
