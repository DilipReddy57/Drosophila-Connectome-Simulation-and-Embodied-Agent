{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical aggregated connection record",
  "type": "object",
  "required": [
    "pre_neuron_id",
    "post_neuron_id",
    "pre_dense_index",
    "post_dense_index",
    "synapse_count"
  ],
  "properties": {
    "pre_dense_index": {
      "type": "integer",
      "minimum": 0
    },
    "post_dense_index": {
      "type": "integer",
      "minimum": 0
    },
    "synapse_count": {
      "type": "integer",
      "minimum": 1
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_nt_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Source-derived neurotransmitter annotation strictly preserved without semantic conversion to sign or conductance."
    },
    "pre_neuron_id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "post_neuron_id": {
      "type": [
        "string",
        "integer"
      ]
    }
  },
  "allOf": [
    { "not": { "required": ["weight"] } },
    { "not": { "required": ["delay"] } },
    { "not": { "required": ["sign"] } }
  ]
}
