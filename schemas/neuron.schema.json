{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical neuron record",
  "type": "object",
  "required": [
    "neuron_id",
    "dense_index"
  ],
  "properties": {
    "neuron_id": {
      "type": [
        "string",
        "integer"
      ]
    },
    "dense_index": {
      "type": "integer",
      "minimum": 0
    },
    "cell_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "super_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "class": {
      "type": [
        "string",
        "null"
      ]
    },
    "subclass": {
      "type": [
        "string",
        "null"
      ]
    },
    "hemilineage": {
      "type": [
        "string",
        "null"
      ]
    },
    "side": {
      "type": [
        "string",
        "null"
      ]
    },
    "neurotransmitter": {
      "type": [
        "string",
        "null"
      ]
    },
    "neurotransmitter_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  }
}
