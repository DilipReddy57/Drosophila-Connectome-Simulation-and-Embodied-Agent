{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset manifest",
  "type": "object",
  "required": ["dataset_id", "name", "version", "sex", "coverage", "source_id", "source_url", "license", "retrieved_at", "files"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "sex": {"enum": ["female", "male", "both", "unknown"]},
    "coverage": {"enum": ["brain", "cns", "nerve_cord", "other"]},
    "source_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "license": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "role", "format"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "role": {"type": "string"}, "format": {"type": "string"}}}}
  }
}
